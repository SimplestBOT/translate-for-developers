<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Translator.Core</RootNamespace>
    <AssemblyName>TranslatorCore</AssemblyName>
    <Version>1.3.0</Version>
    <Product>translate-for-developers</Product>
    <AssemblyTitle>translator 业务核心（阶段 3：Translation/Provider/Configuration/Clipboard）</AssemblyTitle>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- JSON 走 GAC 的 System.Web.Extensions（JavaScriptSerializer），零新增部署 DLL -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <!-- Clipboard 模块需要 WinForms（宿主在 STA UI 线程调用） -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TranslatorCore.Tests" />
  </ItemGroup>

</Project>
